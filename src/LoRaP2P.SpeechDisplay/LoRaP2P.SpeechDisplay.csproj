<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Vosk" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoRaP2P.Display.RadioBonnet\LoRaP2P.Display.RadioBonnet.csproj" />
    <InternalsVisibleTo Include="LoRaP2P.Console.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
    <None Update="runtimes\linux-arm64\native\libvosk.so">
      <TargetPath>libvosk.so</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="runtimes\linux-arm64\native\COPYING">
      <TargetPath>licenses\Vosk-COPYING</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="runtimes\linux-arm64\native\README.md">
      <TargetPath>licenses\Vosk-Native-README.md</TargetPath>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>